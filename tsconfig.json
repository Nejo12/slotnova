{
  "extends": "@slotnova/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "tooling/**/__tests__/**/*.ts",
    "vitest.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/*.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/__fixtures__/**"]
}
