# Copy only the variables for the process being launched; do not inject this
# combined reference file into hosted services. All values below are placeholders.
SLOTNOVA_ENV=local
# API (ordinary, non-owner, non-BYPASSRLS principal)
DATABASE_URL=postgresql://slotnova_app:REPLACE_LOCALLY@localhost:5432/slotnova
DATABASE_SSL=disable
DATABASE_CONNECTION_MODE=direct
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000
API_PORT=3001
API_HOST=0.0.0.0
API_CREDENTIAL_ADAPTER=development
API_SECURE_COOKIES=false
API_ENABLE_HSTS=false
API_CORS_ALLOWED_ORIGINS=http://localhost:3000
API_TRUST_PROXY=
API_RATE_LIMIT_AUTH_MAX=20
API_RATE_LIMIT_PREVIEW_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_KEYS=10000
# Worker ONLY: dedicated direct session endpoint, separate runtime principal.
WORKER_DATABASE_URL=postgresql://slotnova_worker:REPLACE_LOCALLY@localhost:5432/slotnova
WORKER_DATABASE_CONNECTION_MODE=direct
WORKER_SCHEDULER_SCHEMA=pgboss
WORKER_SCHEDULER_MIGRATE=false
WORKER_SCHEDULER_POOL_MAX=10
# Explicit release processes ONLY; never supply these to API/worker services.
DATABASE_MIGRATION_URL=postgresql://slotnova_migrator:REPLACE_LOCALLY@localhost:5432/slotnova
SCHEDULER_MIGRATION_URL=postgresql://scheduler_release:REPLACE_LOCALLY@localhost:5432/slotnova
SCHEDULER_OWNER_ROLE=slotnova_scheduler_owner
# Web build ONLY. Hosted builds require an empty URL (same public origin).
VITE_API_URL=http://localhost:3001
VITE_E2E=false
# Hosted processes additionally require DATABASE_SSL=require and an approved CA
# bundle delivered before startup, e.g. NODE_EXTRA_CA_CERTS=/run/config/rds-ca.pem.
# Hosted API requires API_CREDENTIAL_ADAPTER=disabled, secure cookies, HSTS,
# explicit HTTPS CORS origins, and reviewed ALB subnet CIDRs for trusted proxies.
