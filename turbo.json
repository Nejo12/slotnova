{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "tokens:generate": {
      "outputs": [],
      "cache": false
    },
    "contracts:generate": {
      "outputs": [],
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      // Local-dev env vars (never secrets — see docs/runbooks/local-dev.md).
      // Turbo's default strict env mode otherwise drops these before they
      // reach `tsx watch` / `vite`.
      "env": ["DATABASE_URL", "API_*", "VITE_*"]
    }
  }
}
