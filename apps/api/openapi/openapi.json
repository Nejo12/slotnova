  "info": {
    "title": "Slotnova API",
    "description": "Slotnova platform-foundation HTTP contract (Phase 1).",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SignInRequestDto": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "credential"
        ]
      },
      "SignInResponseDto_Output": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "displayName",
              "email"
            ],
            "additionalProperties": false
          },
          "activeWorkspace": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "role"
            ],
            "additionalProperties": false,
            "nullable": true
          },
          "workspaces": {
            "type": "array",
            "readOnly": true,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "role"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "user",
          "activeWorkspace",
          "workspaces"
        ],
        "additionalProperties": false
      },
      "MeResponseDto_Output": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "displayName",
              "email"
            ],
            "additionalProperties": false
          },
          "activeWorkspace": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "permissions": {
                "readOnly": true,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "permissions"
            ],
            "additionalProperties": false,
            "nullable": true
          },
          "workspaces": {
            "type": "array",
            "readOnly": true,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "session": {
            "type": "object",
            "properties": {
              "expiresAt": {
                "type": "string"
              }
            },
            "required": [
              "expiresAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "user",
          "activeWorkspace",
          "workspaces",
          "session"
        ],
        "additionalProperties": false
      },
      "WorkspaceSwitchRequestDto": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "workspaceId"
        ]
      },
      "IssueInvitationRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "manager",
              "staff"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "IssueInvitationResponseDto_Output": {
        "type": "object",
        "properties": {
          "invitation": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "expiresAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "role",
              "status",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "invitation"
        ],
        "additionalProperties": false
      },
      "InvitationPreviewResponseDto_Output": {
        "type": "object",
        "properties": {
          "workspaceName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "workspaceName",
          "role",
          "email",
          "status",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "RevokeInvitationRequestDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "revoked"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
