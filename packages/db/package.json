{
  "name": "@slotnova/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Slotnova database infrastructure: PostgreSQL client factory, gated migration runner, real-PostgreSQL test harness. Owns no business/domain schema.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/bin/migrate.js",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "pg": "8.23.0",
    "@slotnova/deployment-config": "workspace:*"
  },
  "devDependencies": {
    "@slotnova/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "testcontainers": "12.1.0"
  }
}
