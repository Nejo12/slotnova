{
  "name": "@slotnova/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Slotnova database infrastructure: PostgreSQL client factory, gated migration runner, real-PostgreSQL test harness. Owns no business/domain schema.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/bin/migrate.js",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@slotnova/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/pg": "^8.20.4",
    "testcontainers": "^12.0.4"
  }
}
