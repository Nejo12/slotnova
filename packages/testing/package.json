{
  "name": "@slotnova/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Slotnova test-support package: fast-check property scaffold, MSW HTTP-contract harness (node + browser), valid-by-default test-data builders, and an in-memory telemetry/domain-event sink. Test code only; carries no product domain model, no database mock, and no vendor SDK.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./property": {
      "source": "./src/property/index.ts",
      "types": "./dist/property/index.d.ts",
      "default": "./dist/property/index.js"
    },
    "./builders": {
      "source": "./src/builders/index.ts",
      "types": "./dist/builders/index.d.ts",
      "default": "./dist/builders/index.js"
    },
    "./telemetry": {
      "source": "./src/telemetry.ts",
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./msw": {
      "source": "./src/msw/handlers.ts",
      "types": "./dist/msw/handlers.d.ts",
      "default": "./dist/msw/handlers.js"
    },
    "./msw/node": {
      "source": "./src/msw/node.ts",
      "types": "./dist/msw/node.d.ts",
      "default": "./dist/msw/node.js"
    },
    "./msw/browser": {
      "source": "./src/msw/browser.ts",
      "types": "./dist/msw/browser.d.ts",
      "default": "./dist/msw/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fast-check": "^4.9.0",
    "msw": "^2.15.0"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@slotnova/contracts": "workspace:*",
    "@slotnova/tsconfig": "workspace:*",
    "vitest": "^5.0.0"
  }
}
