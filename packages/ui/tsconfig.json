{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@slotnova/tsconfig/react.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client"]
  },
  "include": [".storybook/**/*.ts", ".storybook/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "**/__fixtures__/**"]
}
