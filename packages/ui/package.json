{
  "name": "@slotnova/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Slotnova composition/presentation layer over the consumed Nova-UI primitive library (@nova-component/ui, pinned per ADR-025): a Slotnova -> Nova CSS-variable theme bridge, shared system-state compositions, and Slotnova-local Storybook. No product-domain logic.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme/nova-bridge.css"
  },
  "files": [
    "dist",
    "src/theme/nova-bridge.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test:visual": "playwright test --config visual/playwright.visual.config.ts"
  },
  "dependencies": {
    "@nova-component/design-tokens": "0.1.1",
    "@nova-component/ui": "0.3.0",
    "@slotnova/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@slotnova/eslint-config": "workspace:*",
    "@slotnova/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "http-server": "^14.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.1",
    "storybook": "^10.6.0",
    "vite": "^8.2.2"
  }
}
