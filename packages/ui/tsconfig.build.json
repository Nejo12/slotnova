{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@slotnova/tsconfig/react.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/__fixtures__/**", "**/*.stories.tsx"]
}
