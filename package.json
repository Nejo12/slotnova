{
  "name": "slotnova",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:styles": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "lint:boundaries": "depcruise --config tooling/dependency-cruiser/.dependency-cruiser.cjs --no-progress .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "turbo run test:integration",
    "tokens:generate": "turbo run tokens:generate",
    "contracts:generate": "turbo run contracts:generate",
    "contracts:check": "bash tooling/contracts/check-drift.sh",
    "contracts:check:breaking": "tsx tooling/contracts/check-breaking-changes.ts",
    "e2e": "pnpm --filter @slotnova/web e2e",
    "e2e:server": "tsx tooling/e2e/api-server.ts",
    "db:migrate": "turbo run db:migrate",
    "dev:web": "turbo run dev --filter=@slotnova/web",
    "dev:api": "turbo run dev --filter=@slotnova/api",
    "dev:worker": "turbo run dev --filter=@slotnova/worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@slotnova/db": "workspace:*",
    "@slotnova/eslint-config": "workspace:*",
    "@slotnova/tsconfig": "workspace:*",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
